# Server-only configuration. Copy to .env.local for local development;
# set the same variables on your existing hosting provider for production.
SECRET_DATABASE_URL=
SECRET_DATABASE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_ADMIN_KEY=
# Exact public origin, with scheme and no trailing slash.
SECRET_SITE_ORIGIN=http://localhost:4321
