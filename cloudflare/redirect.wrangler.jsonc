{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "williambratz-apex-redirect",
  "account_id": "31d30dfccd84717b3e3b401f5e3f5478",
  "main": "./redirect-worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "williambratz.com/*", "zone_name": "williambratz.com" },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
