{
  "name": "williambratzdotcom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-external-links.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "start": "astro preview --host 0.0.0.0 --port $PORT",
    "check": "astro check",
    "test:a11y": "playwright test",
    "quality": "npm run format:check && npm run build && npm run check:links && npm run check:metadata"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.0.4"
  }
}
