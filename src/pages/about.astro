---
import About from "../../pages/about";
import BaseLayout from "../layouts/BaseLayout.astro";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "William Bratz",
  alternateName: "Billy Bratz",
  url: "https://www.williambratz.com/about",
  image: "https://www.williambratz.com/headerphoto.jpg",
  jobTitle: "Senior Software Engineer",
  homeLocation: { "@type": "Place", name: "Tri-Cities, Tennessee" },
  knowsAbout: [
    "Context engineering",
    "Large language model agents",
    "AI coding agents",
    "Model Context Protocol",
    "Knowledge systems",
    "Distributed systems",
  ],
  sameAs: [
    "https://github.com/wbratz",
    "https://www.linkedin.com/in/williambratz",
  ],
};
---

<BaseLayout
  title="About William Bratz | Context Engineer for AI Agents"
  description="William Bratz is a senior software engineer in Tri-Cities, Tennessee, focused on context engineering for production AI agents and coding agents."
  canonical="https://www.williambratz.com/about"
  type="profile"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <About />
</BaseLayout>
