---
import AiEngineering from "../../pages/ai-engineering";
import BaseLayout from "../layouts/BaseLayout.astro";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "AI Engineering and LLM Systems by William Bratz",
  url: "https://www.williambratz.com/ai-engineering",
  mainEntity: {
    "@type": "Person",
    name: "William Bratz",
    alternateName: "Billy Bratz",
    url: "https://www.williambratz.com",
    image: "https://www.williambratz.com/headerphoto.jpg",
    jobTitle: "Senior Software Engineer",
    homeLocation: {
      "@type": "Place",
      name: "Tri-Cities, Tennessee",
    },
    knowsAbout: [
      "Artificial intelligence engineering",
      "Large language model agents",
      "Model Context Protocol",
      "Distributed systems",
      "AI evaluation",
      "Knowledge management",
      "Python",
      "C#",
      "Kubernetes",
    ],
    sameAs: [
      "https://github.com/wbratz",
      "https://www.linkedin.com/in/williambratz",
    ],
  },
};
---

<BaseLayout
  title="AI Engineering & LLM Systems | William Bratz"
  description="William Bratz builds production LLM agents, MCP infrastructure, AI developer tools, durable context systems, evaluations, and reliable distributed software."
  canonical="https://www.williambratz.com/ai-engineering"
  type="profile"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <AiEngineering />
</BaseLayout>
