---
import BaseLayout from "../layouts/BaseLayout.astro";

const suggestions = [
  "How did Billy extend the LLM Wiki pattern in the Vault?",
  "How does the ontology pipeline help route rules to coding agents?",
  "Why hasn't the Vault added a formal ontology or knowledge graph?",
  "What did Billy's Vault experiments actually measure?",
];
---

<BaseLayout
  title="Ask Billy | Billy Bratz"
  description="Ask questions about Billy Bratz's published projects and engineering writing. Answers link to the pages that support them."
  canonical="https://www.williambratz.com/ask"
>
  <div class="ask-page">
    <header class="intro">
      <p class="eyebrow">Explore the work</p>
      <h1>Ask about my work.</h1>
      <p>
        I build context systems for people and AI agents, then test whether they
        improve real work. Ask how my Vault extends the LLM Wiki pattern, how I
        apply the ontology pipeline, or what my coding-agent experiments
        measured. Answers use my published work and link to its sources.
      </p>
    </header>

    <section class="ask-panel" aria-label="Ask a question">
      <form id="ask-form">
        <label for="question">What would you like to understand?</label>
        <div class="form-row">
          <textarea
            id="question"
            name="question"
            rows="3"
            maxlength="500"
            required
            placeholder="How does the Vault preserve evidence?"></textarea>
          <button type="submit">Ask</button>
        </div>
      </form>
      <div class="suggestions" aria-label="Suggested questions">
        {
          suggestions.map((question) => (
            <button type="button" data-suggestion={question}>
              {question}
            </button>
          ))
        }
      </div>
      <p class="status" id="ask-status" role="status" aria-live="polite"></p>
      <div class="answer" id="ask-answer" hidden>
        <h2>Answer</h2>
        <div id="answer-text"></div>
        <div id="answer-sources" hidden>
          <h3>Read the sources</h3>
          <ul id="source-list"></ul>
        </div>
      </div>
    </section>
    <section class="reading" aria-labelledby="reading-title">
      <h2 id="reading-title">Start with the source material</h2>
      <p>
        The assistant can summarize these public pages. The details, methods,
        and limits are in the writing itself.
      </p>
      <ul>
        <li>
          <a href="/blog/vault-context-system"
            >The Vault: From LLM Wiki to Context System</a
          >
          <span>How I connect evidence, meaning, delivery, and evaluation.</span
          >
        </li>
        <li>
          <a href="/coding-agents">Context for Coding Agents</a>
          <span
            >How the first four ontology-pipeline stages route rules, with the
            measured result.</span
          >
        </li>
        <li>
          <a href="/projects/vault/path">Explore the Vault path</a>
          <span>What is built, in pilot, measured, or still open.</span>
        </li>
      </ul>
    </section>
    <section class="mcp" aria-labelledby="mcp-title">
      <h2 id="mcp-title">Use your own AI client</h2>
      <p>
        Connect an AI client that supports remote MCP over HTTP. Its search tool
        can read the same published pages and return source excerpts. It has no
        write tools or access to my private Vault.
      </p>
      <code
        >https://24d19abd-13f1-426b-8628-c1d921fc4584.search.ai.cloudflare.com/mcp</code
      >
    </section>
    <p class="scope">
      This assistant reads published site content. It cannot see my private
      local Vault or unpublished work. Answers can be wrong; check the linked
      pages for the full context.
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#ask-form");
  const field = document.querySelector<HTMLTextAreaElement>("#question");
  const status = document.querySelector<HTMLElement>("#ask-status");
  const panel = document.querySelector<HTMLElement>("#ask-answer");
  const answerText = document.querySelector<HTMLElement>("#answer-text");
  const sourcePanel = document.querySelector<HTMLElement>("#answer-sources");
  const sourceList = document.querySelector<HTMLUListElement>("#source-list");
  const submit = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  async function ask(question: string) {
    if (
      !form ||
      !field ||
      !status ||
      !panel ||
      !answerText ||
      !sourcePanel ||
      !sourceList ||
      !submit
    )
      return;
    field.value = question;
    status.textContent = "Looking through Billy's published work…";
    panel.hidden = true;
    submit.disabled = true;
    try {
      const response = await fetch("/api/ask", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question }),
      });
      const data = (await response.json()) as {
        answer?: string;
        sources?: { url: string; title: string }[];
        error?: string;
      };
      if (!response.ok)
        throw new Error(data.error || "The answer service is unavailable.");
      answerText.textContent = data.answer || "No answer was returned.";
      sourceList.replaceChildren();
      for (const source of data.sources || []) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = source.url;
        link.textContent = source.title;
        item.appendChild(link);
        sourceList.appendChild(item);
      }
      sourcePanel.hidden = sourceList.childElementCount === 0;
      panel.hidden = false;
      status.textContent = "";
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : "Something went wrong.";
    } finally {
      submit.disabled = false;
    }
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const question = field?.value.trim();
    if (question) void ask(question);
  });
  document
    .querySelectorAll<HTMLButtonElement>("[data-suggestion]")
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => void ask(button.dataset.suggestion || ""),
      );
    });
</script>

<style>
  .ask-page {
    width: min(calc(100% - 2rem), 54rem);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) 0 5rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--link-color);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: var(--heading-color);
    font-size: clamp(2.8rem, 7vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .intro > p:last-child {
    max-width: 65ch;
    margin: 1.5rem 0 2.5rem;
    color: var(--text-muted);
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.6;
  }
  .ask-panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--surface-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
  }
  label {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--heading-color);
    font-weight: 650;
  }
  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  textarea {
    width: 100%;
    min-height: 7rem;
    padding: 0.9rem 1rem;
    resize: vertical;
    color: var(--text-color);
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 0.6rem;
    font: inherit;
    line-height: 1.5;
  }
  .form-row > button {
    align-self: flex-start;
    min-height: 2.75rem;
    padding: 0.6rem 1.4rem;
    color: var(--bg-color);
    background: var(--link-color);
    border: 0;
    border-radius: 0.6rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .form-row > button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .suggestions button {
    padding: 0.55rem 0.7rem;
    color: var(--text-color);
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    text-align: left;
  }
  .suggestions button:hover {
    border-color: var(--link-color);
  }
  .status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    color: var(--text-muted);
  }
  .answer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }
  .answer h2 {
    margin: 0 0 0.75rem;
    color: var(--heading-color);
    font-size: 1.4rem;
  }
  #answer-text {
    white-space: pre-wrap;
    line-height: 1.65;
  }
  .answer h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.9rem;
  }
  .answer ul {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.9;
  }
  .answer a {
    color: var(--link-color);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .scope {
    max-width: 70ch;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .reading {
    margin-top: 2.5rem;
  }
  .reading h2 {
    margin: 0 0 0.5rem;
    color: var(--heading-color);
    font-size: 1.35rem;
  }
  .reading > p {
    color: var(--text-muted);
    line-height: 1.6;
  }
  .reading ul {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .reading li {
    display: grid;
    gap: 0.25rem;
  }
  .reading a {
    color: var(--link-color);
    font-weight: 650;
    text-underline-offset: 0.2em;
  }
  .reading li span {
    color: var(--text-muted);
    line-height: 1.5;
  }
  .mcp {
    margin-top: 2.5rem;
  }
  .mcp h2 {
    margin: 0 0 0.5rem;
    color: var(--heading-color);
    font-size: 1.35rem;
  }
  .mcp p {
    max-width: 70ch;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .mcp code {
    display: block;
    padding: 0.9rem;
    overflow-wrap: anywhere;
    background: var(--surface-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.6rem;
    font-size: 0.8rem;
  }
</style>
