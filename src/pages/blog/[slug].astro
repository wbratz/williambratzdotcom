---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  getAdjacentPosts,
  getPosts,
  getRelatedPosts,
  getSeriesPosts,
  toDateString,
  type Post,
} from "../../lib/posts";
import styles from "../../../styles/blog.module.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post, posts },
  }));
}

type Props = { post: Post; posts: Post[] };
const { post, posts } = Astro.props;
const { Content } = await render(post);
const seriesPosts = getSeriesPosts(posts, post.data.series);
const relatedPosts = getRelatedPosts(posts, post);
const adjacent = getAdjacentPosts(posts, post);
const canonical = `https://www.williambratz.com/blog/${post.data.slug}`;
const assetPath = (value: string) => `/${value.replace(/^(\.\.\/|\.\/)/, "")}`;
const bannerImage = assetPath(post.data.banner);
const socialImage = post.data.socialImage
  ? assetPath(post.data.socialImage)
  : bannerImage;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  keywords: post.data.topics.join(", "),
  author: {
    "@type": "Person",
    name: "William Bratz",
    url: "https://www.williambratz.com",
  },
  mainEntityOfPage: canonical,
  image: new URL(socialImage, Astro.site).toString(),
};
---

<BaseLayout
  title={`${post.data.title} | William Bratz`}
  description={post.data.description}
  canonical={canonical}
  type="article"
  image={socialImage}
  imageAlt={post.data.imageAlt}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    {
      post.data.updated && (
        <meta
          property="article:modified_time"
          content={post.data.updated.toISOString()}
        />
      )
    }
    {
      post.data.topics.map((topic) => (
        <meta property="article:tag" content={topic} />
      ))
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <article class={styles.blogPostContainer}>
    <div class={styles.blogPostBanner}>
      <img
        src={bannerImage}
        alt={post.data.imageAlt}
        width="1200"
        height="630"
        fetchpriority="high"
      />
    </div>
    <header class={styles.blogPostTitle}>
      <p class={styles.blogPostMeta}>
        <time datetime={toDateString(post.data.date)}
          >{formatDate(post.data.date, true)}</time
        >
        <span aria-hidden="true">·</span>
        <span>{post.readingTime} min read</span>
        {
          post.data.updated &&
            toDateString(post.data.updated) !==
              toDateString(post.data.date) && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(post.data.updated, true)}</span>
              </>
            )
        }
      </p>
      <h1>{post.data.title}</h1>
      <ul class={styles.articleTopics} aria-label="Article topics">
        {post.data.topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </header>

    {
      post.data.series && seriesPosts.length > 1 && (
        <aside class={styles.series} aria-labelledby="series-title">
          <div>
            <p>Series</p>
            <h2 id="series-title">{post.data.series}</h2>
          </div>
          <ol>
            {seriesPosts.map((seriesPost) => (
              <li>
                {seriesPost.data.slug === post.data.slug ? (
                  <span aria-current="page">{seriesPost.data.title}</span>
                ) : (
                  <a href={`/blog/${seriesPost.data.slug}`}>
                    {seriesPost.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </aside>
      )
    }

    <div class={styles.blogPostContent}>
      <Content />
    </div>

    <nav class={styles.articlePagination} aria-label="Adjacent essays">
      {
        adjacent.older ? (
          <a href={`/blog/${adjacent.older.data.slug}`}>
            <span>Older essay</span>
            <strong>{adjacent.older.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        adjacent.newer && (
          <a
            class={styles.newerPost}
            href={`/blog/${adjacent.newer.data.slug}`}
          >
            <span>Newer essay</span>
            <strong>{adjacent.newer.data.title}</strong>
          </a>
        )
      }
    </nav>

    {
      relatedPosts.length > 0 && (
        <section class={styles.related} aria-labelledby="related-title">
          <p>Keep reading</p>
          <h2 id="related-title">Related essays</h2>
          <div>
            {relatedPosts.map((related) => (
              <article>
                <p>{related.data.topics.slice(0, 2).join(" · ")}</p>
                <h3>
                  <a href={`/blog/${related.data.slug}`}>
                    {related.data.title}
                  </a>
                </h3>
                <p>{related.data.description}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
