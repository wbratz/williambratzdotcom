---
import Resume from "../../pages/resume";
import BaseLayout from "../layouts/BaseLayout.astro";

const resumeSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "William Bratz Resume",
  url: "https://www.williambratz.com/resume",
  mainEntity: {
    "@type": "Person",
    name: "William Bratz",
    alternateName: "Billy Bratz",
    jobTitle: "Senior Software Engineer",
    url: "https://www.williambratz.com",
    homeLocation: {
      "@type": "Place",
      name: "Tri-Cities, Tennessee",
    },
    knowsAbout: [
      "Production artificial intelligence",
      "Large language model agents",
      "Model Context Protocol",
      "Distributed systems",
      "Python",
      "C#",
      "Kubernetes",
    ],
    sameAs: [
      "https://github.com/wbratz",
      "https://www.linkedin.com/in/williambratz",
    ],
  },
};
---

<BaseLayout
  title="William “Billy” Bratz | Senior AI & Software Engineer"
  description="Résumé for William Bratz, a senior software engineer focused on context engineering for AI agents and distributed systems."
  canonical="https://www.williambratz.com/resume"
  type="profile"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(resumeSchema)}
  />
  <Resume />
</BaseLayout>
