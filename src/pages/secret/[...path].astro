---
import SecretPage from "../../components/private/SecretPage";
import type { Props } from "../../components/private/SecretPage";
import SecretDocument from "../../layouts/SecretDocument.astro";
import { privateContext } from "../../server/private-http";
import {
  authorized,
  directory,
  isAdmin,
  privateHeaders,
  query,
} from "../../server/secret";
import type { Grant } from "../../server/secret";

export const prerender = false;
const ctx = privateContext(Astro.request);
privateHeaders(ctx.res);
const route = Astro.params.path || "";
let props: Props;
if (route.includes("/"))
  return new Response("Not found", {
    status: 404,
    headers: ctx.responseHeaders(),
  });
try {
  const admin = isAdmin(ctx.req);
  if (route === "invite") props = { mode: "invite" };
  else if (route === "admin" && !admin) props = { mode: "login" };
  else {
    if (!(await authorized(ctx.req, ctx.res)))
      return new Response("Not found", {
        status: 404,
        headers: ctx.responseHeaders(),
      });
    const data = await directory();
    if (route === "admin") {
      const grants = await query<Grant>(
        "SELECT id, label, created_at, invite_expires, accepted_at, last_seen, revoked, session_expires FROM secret_grants ORDER BY created_at DESC LIMIT 200",
      );
      props = { mode: "admin", admin: true, ...data, grants };
    } else {
      if (route && !data.categories.some((category) => category.slug === route))
        return new Response("Not found", {
          status: 404,
          headers: ctx.responseHeaders(),
        });
      props = { mode: "directory", admin, category: route, ...data };
    }
  }
} catch {
  Astro.response.status = 503;
  props = { mode: "unavailable" };
}
for (const [key, value] of ctx.responseHeaders())
  Astro.response.headers.append(key, value);
---

<SecretDocument
  title={props.mode === "admin" || props.mode === "login"
    ? "The control room"
    : "The side door"}
>
  <SecretPage {...props} client:load />
</SecretDocument>
