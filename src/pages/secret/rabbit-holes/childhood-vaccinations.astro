---
import ChildhoodVaccinations from "../../../components/private/ChildhoodVaccinations";
import SecretDocument from "../../../layouts/SecretDocument.astro";
import { privateContext } from "../../../server/private-http";
import { authorized, privateHeaders } from "../../../server/secret";
import { loadVaccinationData } from "../../../server/vaccination-data";
export const prerender = false;
const ctx = privateContext(Astro.request);
privateHeaders(ctx.res);
let data;
let unavailable = false;
try {
  if (!(await authorized(ctx.req, ctx.res)))
    return new Response("Not found", {
      status: 404,
      headers: ctx.responseHeaders(),
    });
  data = loadVaccinationData();
} catch {
  Astro.response.status = 503;
  unavailable = true;
}
for (const [key, value] of ctx.responseHeaders())
  Astro.response.headers.append(key, value);
---

<SecretDocument title="Childhood Vaccinations · Rabbit holes">
  <ChildhoodVaccinations data={data} unavailable={unavailable} client:load />
</SecretDocument>
